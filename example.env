#
# Settings for Make and Docker
#
PHP_VERSION=8.5
PHP_EXTENSIONS="mbstring json intl"
DOCKER_IMAGE_NAME=local/harvest-tooling

#
# Your Harvest Account Credentials. Required.
#
HARVEST_PAT=
HARVEST_ACCOUNT_ID=

#
# Kimai host and API token. Also required!
# Note - only **host** i.e. "example.com". If you don't use https, or Kimai is not installed at the server root, then
# you can't use this without forking etc.
#
KIMAI_TOKEN=
KIMAI_HOST=time.example.com

#
# Generic import settings
#
# Currently, all imported customers get these values
#
TZ=UTC
DEFAULT_LANG=en
DEFAULT_CURRENCY=GBP
DEFAULT_COUNTRY=GB
